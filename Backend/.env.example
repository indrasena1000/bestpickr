# ─────────────────────────────────────────────────────────────────
# bestpickr Backend — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git (it's in .gitignore)
# ─────────────────────────────────────────────────────────────────

# ── SERVER ────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── DATABASE ──────────────────────────────────────────────────────
# Free PostgreSQL: https://neon.tech → create project → copy connection string
# Local PostgreSQL: postgresql://postgres:yourpassword@localhost:5432/bestpickr
DATABASE_URL="postgresql://neondb_owner:npg_d6N7LJBVsFqg@ep-quiet-sound-aidqt1vx-pooler.c-4.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ── AMAZON PRODUCT ADVERTISING API (PA5) ─────────────────────────
# Get at: https://affiliate-program.amazon.in
# → Tools → Product Advertising API → Manage credentials
AMAZON_ACCESS_KEY=your_amazon_access_key
AMAZON_SECRET_KEY=your_amazon_secret_key
AMAZON_ASSOCIATE_TAG=your_associate_tag-21
AMAZON_HOST=webservices.amazon.in
AMAZON_REGION=eu-west-1

# ── FLIPKART AFFILIATE API ────────────────────────────────────────
# Get at: https://affiliate.flipkart.com/login
# → My Account → API → Generate Token
FLIPKART_AFFILIATE_ID=your_flipkart_affiliate_id
FLIPKART_TOKEN=your_flipkart_token

# ── MYNTRA ────────────────────────────────────────────────────────
# Myntra has no public API → we scrape respectfully
# Set delay between requests to be polite
MYNTRA_SCRAPE_DELAY_MS=1500

# ── AI / LLM (optional — for review summarization) ───────────────
# Get at: https://console.anthropic.com
# Used for generating "What users love / What users dislike" summaries
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── CACHE ─────────────────────────────────────────────────────────
# How long to cache search results (seconds)
# 3600 = 1 hour. Lower = fresher data but more API calls
CACHE_TTL_SECONDS=3600

# ── RATE LIMITING ─────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── SECURITY ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string_in_production

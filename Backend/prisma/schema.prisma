// ─────────────────────────────────────────────────────────────────
// bestpickr — Prisma Schema (Prisma 5.22 compatible)
// ─────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── PRODUCT ───────────────────────────────────────────────────────
model Product {
  id              String    @id @default(uuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  name            String
  brand           String?
  category        String?
  imageUrl        String?
  description     String?

  platform        Platform
  platformId      String
  platformUrl     String
  affiliateUrl    String?

  currentPrice    Float
  originalPrice   Float?
  currency        String          @default("INR")
  inStock         Boolean         @default(true)

  platformRating  Float?
  reviewCount     Int             @default(0)

  aiScore         Float?
  lastScored      DateTime?

  productGroupId  String?

  reviews         Review[]
  priceHistory    PriceHistory[]

  @@unique([platform, platformId])
  @@index([category])
  @@index([productGroupId])
  @@index([aiScore])
}

// ── REVIEW ────────────────────────────────────────────────────────
model Review {
  id              String    @id @default(uuid())
  createdAt       DateTime  @default(now())

  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  platform        Platform
  totalCount      Int       @default(0)
  averageRating   Float?

  positiveCount   Int       @default(0)
  neutralCount    Int       @default(0)
  negativeCount   Int       @default(0)
  positivePct     Float?
  negativePct     Float?

  praiseSummary    String?
  complaintSummary String?

  analyzedAt      DateTime?

  @@unique([productId, platform])
}

// ── PRICE HISTORY ─────────────────────────────────────────────────
model PriceHistory {
  id          String    @id @default(uuid())
  recordedAt  DateTime  @default(now())

  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  price       Float
  currency    String    @default("INR")

  @@index([productId, recordedAt])
}

// ── SEARCH CACHE ──────────────────────────────────────────────────
model SearchCache {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  expiresAt   DateTime

  query       String
  category    String?
  resultJson  Json
  hitCount    Int       @default(1)

  @@unique([query, category])
  @@index([expiresAt])
}

// ── CATEGORY ──────────────────────────────────────────────────────
model Category {
  id           String  @id @default(uuid())
  slug         String  @unique
  name         String
  emoji        String
  productCount Int     @default(0)
}

// ── ENUMS ─────────────────────────────────────────────────────────
enum Platform {
  AMAZON
  FLIPKART
  MYNTRA
}

// ── ANALYTICS ─────────────────────────────────────────────────────
model PageView {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  sessionId    String
  visitorId    String
  eventType    String
  page         String?
  query        String?
  productName  String?
  productId    String?
  affiliateUrl String?
  referrer     String?
  userAgent    String?
  screenWidth  Int?
  path         String?

  @@index([createdAt])
  @@index([visitorId])
  @@index([eventType])
}

// ── SEARCH QUERY MAPPING ──────────────────────────────────────────
// Learned brand+category associations from live Amazon fetches.
// When an unknown query (e.g. "safari bags") hits Amazon and returns results,
// we store the derived brand+category so future searches skip Amazon entirely.
model SearchQueryMapping {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  normalizedQuery String   @unique   // normalized form, e.g. "bag safari"
  brand           String?            // e.g. "safari"
  category        String?            // e.g. "fashion"
  hitCount        Int      @default(1)
  learnedFrom     String   @default("amazon_api")

  @@index([normalizedQuery])
}

// ── SITE CONFIG ───────────────────────────────────────────────────
// Persistent key-value store for admin settings (maintenance mode etc.)
model SiteConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@index([key])
}

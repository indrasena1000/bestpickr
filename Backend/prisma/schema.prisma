// ─────────────────────────────────────────────────────────────────
// bestpickr — Prisma Database Schema
// Database: PostgreSQL
//
// TABLES:
//   Product       → cached product data per platform
//   SearchCache   → cached search results (avoid hitting APIs repeatedly)
//   Review        → aggregated review data
//   PriceHistory  → price over time per product per platform
//   Wishlist      → user saved products (future auth feature)
// ─────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── PRODUCT ───────────────────────────────────────────────────────
// One row per product per platform.
// Same physical product appears as multiple rows (one per store).
// We link them via productGroupId (same item, different stores).
model Product {
  id              String    @id @default(uuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Product identity
  name            String
  brand           String?
  category        String?
  imageUrl        String?
  description     String?

  // Platform-specific
  platform        Platform
  platformId      String          // ASIN for Amazon, SKU for Flipkart, etc.
  platformUrl     String          // Affiliate link to buy
  affiliateUrl    String?         // With affiliate tag

  // Pricing
  currentPrice    Float
  originalPrice   Float?
  currency        String          @default("INR")
  inStock         Boolean         @default(true)

  // Ratings from this platform
  platformRating  Float?          // e.g., 4.8
  reviewCount     Int             @default(0)

  // bestpickr AI score
  aiScore         Float?          // 0-10
  lastScored      DateTime?

  // Group: same product across platforms
  productGroupId  String?         // UUID shared across platforms for same item

  // Relations
  reviews         Review[]
  priceHistory    PriceHistory[]

  @@unique([platform, platformId])
  @@index([category])
  @@index([productGroupId])
  @@index([aiScore])
}

// ── REVIEW ────────────────────────────────────────────────────────
model Review {
  id              String    @id @default(uuid())
  createdAt       DateTime  @default(now())

  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  platform        Platform
  totalCount      Int       @default(0)
  averageRating   Float?

  // Sentiment analysis results
  positiveCount   Int       @default(0)
  neutralCount    Int       @default(0)
  negativeCount   Int       @default(0)
  positivePct     Float?
  negativePct     Float?

  // LLM-generated summaries
  praiseSummary   String?   // "Best ANC, great battery..."
  complaintSummary String?  // "Expensive, no IP rating..."

  analyzedAt      DateTime?

  @@unique([productId, platform])
}

// ── PRICE HISTORY ─────────────────────────────────────────────────
model PriceHistory {
  id          String    @id @default(uuid())
  recordedAt  DateTime  @default(now())

  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  price       Float
  currency    String    @default("INR")

  @@index([productId, recordedAt])
}

// ── SEARCH CACHE ──────────────────────────────────────────────────
// Cache search results so we don't hammer APIs on every search.
// TTL is set via backend config (default: 1 hour).
model SearchCache {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  expiresAt   DateTime

  query       String
  category    String?
  resultJson  Json      // Full ranked results array stored as JSON
  hitCount    Int       @default(1)

  @@unique([query, category])
  @@index([expiresAt])
}

// ── CATEGORY ──────────────────────────────────────────────────────
model Category {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  emoji       String
  productCount Int      @default(0)
}

// ── ENUMS ─────────────────────────────────────────────────────────
enum Platform {
  AMAZON
  FLIPKART
  MYNTRA
}
